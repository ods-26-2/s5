{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ods:s5:ods.s5.metrics.reply",
  "title": "ods.s5.metrics.reply",
  "description": "Reply do S5 a ods.s5.metrics.query. Perfil RPL; correlation_id é o message_id da consulta. A série vem em ordem cronológica, com no máximo 1000 pontos. Versão 1.1: com profile na consulta, traz também o perfil de atividade por hora do dia (0–23), dia da semana (1 = segunda … 7 = domingo) ou dia do mês (1–31), no fuso pedido, e o bucket de pico (null se não houve atividade).",
  "allOf": [
    {
      "$ref": "urn:ods:s5:defs#/$defs/rpl"
    }
  ],
  "properties": {
    "schema": {
      "const": "ods.s5.metrics.reply"
    },
    "producer": {
      "const": "S5"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "series"
          ],
          "properties": {
            "status": {
              "const": "OK"
            },
            "series": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "anyOf": [
                  {
                    "$ref": "urn:ods:s5:defs#/$defs/zoneMetricsPayload"
                  },
                  {
                    "$ref": "urn:ods:s5:defs#/$defs/eventMetricsPayload"
                  }
                ]
              }
            },
            "profile": {
              "type": "object",
              "required": [
                "by",
                "timezone",
                "peak_bucket",
                "buckets"
              ],
              "properties": {
                "by": {
                  "enum": [
                    "HOUR_OF_DAY",
                    "DAY_OF_WEEK",
                    "DAY_OF_MONTH"
                  ]
                },
                "timezone": {
                  "$ref": "urn:ods:s5:defs#/$defs/nonEmptyString"
                },
                "peak_bucket": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 31
                },
                "buckets": {
                  "type": "array",
                  "maxItems": 31,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "bucket",
                          "windows",
                          "total_count",
                          "occupancy_peak",
                          "occupancy_avg"
                        ],
                        "properties": {
                          "bucket": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 31
                          },
                          "windows": {
                            "$ref": "urn:ods:s5:defs#/$defs/count"
                          },
                          "total_count": {
                            "$ref": "urn:ods:s5:defs#/$defs/count"
                          },
                          "occupancy_peak": {
                            "$ref": "urn:ods:s5:defs#/$defs/count"
                          },
                          "occupancy_avg": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "bucket",
                          "windows",
                          "count",
                          "uncertain_count"
                        ],
                        "properties": {
                          "bucket": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 31
                          },
                          "windows": {
                            "$ref": "urn:ods:s5:defs#/$defs/count"
                          },
                          "count": {
                            "$ref": "urn:ods:s5:defs#/$defs/count"
                          },
                          "uncertain_count": {
                            "$ref": "urn:ods:s5:defs#/$defs/count"
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "status": {
              "const": "ERROR"
            },
            "error": {
              "allOf": [
                {
                  "$ref": "urn:ods:s5:defs#/$defs/error"
                }
              ],
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_QUERY",
                    "PERIOD_TOO_LONG",
                    "UNKNOWN_ZONE"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "unevaluatedProperties": false
}
